# Biến cho docker-compose (tuỳ chọn: không có file .env thì dùng giá trị mặc định trong compose).
# Copy thành .env nếu muốn đổi. DB_* phải KHỚP với backend/.env.
MYSQL_ROOT_PASSWORD=root
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

# Cổng publish ra máy host
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=5173
